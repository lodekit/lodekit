#!/usr/bin/env bash
# SessionStart hook (startup|clear): refresh this worktree after its PR merges.
#
# The repo squash-merges and auto-deletes branches, so once a PR lands the
# local branch's commits are dead — refresh = reset to origin/master on the
# same branch name. Acts only when provably safe; silent no-op otherwise:
#   dirty tree / detached HEAD       -> untouched
#   clean, no commits beyond master  -> fast-forward reset
#   clean, commits beyond master     -> reset only if HEAD is a merged PR's head
# Plain stdout from a SessionStart hook is injected as session context.
set -euo pipefail

cd "${CLAUDE_PROJECT_DIR:-.}" 2>/dev/null || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
[ -z "$(git status --porcelain)" ] || exit 0
branch=$(git branch --show-current)
[ -n "$branch" ] || exit 0

export GIT_TERMINAL_PROMPT=0
git fetch --prune --quiet origin || exit 0   # offline -> leave it be

ahead=$(git rev-list --count origin/master..HEAD)
behind=$(git rev-list --count HEAD..origin/master)

if [ "$ahead" -eq 0 ]; then
    [ "$behind" -eq 0 ] && exit 0
    git reset --hard --quiet origin/master
    printf 'worktree-refresh: fast-forwarded %s to origin/master (%s).\n' \
        "$branch" "$(git rev-parse --short HEAD)"
    exit 0
fi

# Local commits exist — discard only if this exact tip landed via a merged PR.
merged_heads=$(gh pr list --head "$branch" --state merged --json headRefOid \
    --jq '.[].headRefOid' 2>/dev/null) || exit 0   # no gh / no auth -> can't verify
if grep -qx "$(git rev-parse HEAD)" <<<"$merged_heads"; then
    git reset --hard --quiet origin/master
    printf 'worktree-refresh: %s was squash-merged — reset to origin/master (%s).\n' \
        "$branch" "$(git rev-parse --short HEAD)"
else
    printf 'worktree-refresh: %s has %s unmerged commit(s) beyond origin/master — left untouched.\n' \
        "$branch" "$ahead"
fi
