{
  "name": "lodekit-monorepo",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "LODEKIT_ROOT=$(pwd)/root LODEKIT_CACHE_DIR=$(pwd)/.cache pnpm --filter @lodekit/engine start",
    "mcp": "pnpm --filter @lodekit/mcp start",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "postinstall": "[ -n \"$CI\" ] || playwright install chromium",
    "clean": "node scripts/clean.mjs",
    "clean:worktrees": "node scripts/clean.mjs --all"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.78",
    "@playwright/test": "1.62.0",
    "@types/node": "^22.10.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "lightningcss",
      "sharp"
    ],
    "overrides": {
      "@playwright/mcp>playwright": "1.62.0",
      "@playwright/mcp>playwright-core": "1.62.0",
      "@modelcontextprotocol/sdk>@hono/node-server": "2.0.12",
      "fast-uri": "3.1.5"
    },
    "auditConfig": {
      "ignoreGhsas": ["GHSA-67mh-4wv8-2f99"]
    }
  }
}
