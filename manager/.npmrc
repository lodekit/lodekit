; Only read when pnpm runs with CWD here (e.g. `electron-forge start`), which is enough
; to satisfy Forge's dev-start config check (verified: `pnpm start` fails without it).
; Packaging needs no hoisting: the manager has zero prod dependencies (the platform ships
; via extraResource), so forge.config.js skips every node_modules walk instead —
; rebuildConfig.onlyModules=[], prune:false, and node_modules in the packager ignore list.
node-linker=hoisted
